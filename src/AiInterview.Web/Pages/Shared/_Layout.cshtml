@using AiInterview.Common.Configuration
@inject InfraOptions Infra
<!doctype html>
<html lang="vi" data-bs-theme="light" data-palette="ocean">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(ViewData["Title"] ?? "AI Interview") — AI Interview</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true">
    <script>
        // Áp bảng màu đã chọn trước khi render để không bị nháy màu.
        try {
            var p = localStorage.getItem('palette');
            if (p) document.documentElement.dataset.palette = p;
            if (localStorage.getItem('sidebar') === 'collapsed') document.documentElement.classList.add('sidebar-collapsed');
        } catch (e) { }
    </script>
</head>
<body>
<div class="d-flex vh-100">
    <partial name="_Sidebar" />

    <div class="flex-grow-1 d-flex flex-column overflow-hidden">
        <header class="d-flex align-items-center gap-3 px-4 py-3">
            <button id="sidebarToggle" class="btn btn-light btn-sm border rounded-3 px-2" title="Thu gọn menu">
                <i class="bi bi-layout-sidebar-inset"></i>
            </button>

            <div class="ms-auto d-flex align-items-center gap-2">
                <span class="badge rounded-pill text-bg-light border fw-medium" title="Infra:Mode / Role">
                    <i class="bi bi-hdd-network"></i> @Infra.Mode · @Infra.Role
                </span>
                <div class="btn-group btn-group-sm" role="group" aria-label="Bảng màu">
                    <button type="button" class="btn btn-outline-secondary" data-palette-choice="ocean">Ocean</button>
                    <button type="button" class="btn btn-outline-secondary" data-palette-choice="violet">Violet</button>
                </div>
            </div>
        </header>

        <main class="flex-grow-1 overflow-auto px-4 pb-5">
            @RenderBody()
        </main>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
