@using Microsoft.Extensions.Options
@using AiInterview.Core.Options
@inject IOptions<AiInterviewOptions> AppOptions
<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AI Interview System</title>
    <!-- Bootstrap 5.3.3 & Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --sidebar-width: 260px;
        }
        body {
            background-color: #f8fafc;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .sidebar {
            width: var(--sidebar-width);
            background: #ffffff;
            border-right: 1px solid #e2e8f0;
            position: fixed;
            top: 0;
            bottom: 0;
            left: 0;
            z-index: 100;
            padding-top: 1rem;
        }
        .main-wrapper {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .topbar {
            height: 64px;
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 0 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 99;
        }
        .nav-link {
            color: #475569;
            font-weight: 500;
            border-radius: 8px;
            margin: 0.2rem 0.8rem;
            padding: 0.6rem 0.8rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            transition: all 0.15s ease-in-out;
        }
        .nav-link:hover, .nav-link.active {
            color: #0d6efd;
            background-color: #eff6ff;
        }
        .nav-link i {
            font-size: 1.15rem;
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="px-4 pb-3 border-bottom mb-3">
            <a asp-page="/Index" class="text-decoration-none d-flex align-items-center gap-2">
                <i class="bi bi-robot text-primary fs-3"></i>
                <div>
                    <div class="fw-bold fs-5 text-dark lh-1">AI Interview</div>
                    <small class="text-muted" style="font-size: 0.75rem;">PRN222 Assignment</small>
                </div>
            </a>
        </div>
        <nav class="nav flex-column">
            <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString() == "/Index" ? "active" : "")" asp-page="/Index">
                <i class="bi bi-speedometer2"></i>
                <span>Tổng quan (Dashboard)</span>
            </a>
            <a class="nav-link @(ViewContext.RouteData.Values["page"]?.ToString()?.StartsWith("/Documents") == true ? "active" : "")" asp-page="/Documents/Index">
                <i class="bi bi-folder2-open"></i>
                <span>Quản lý Tài liệu (Dev A)</span>
            </a>
            <a class="nav-link text-muted" href="#" title="Dev B Scope">
                <i class="bi bi-question-circle"></i>
                <span>Ngân hàng câu hỏi (Dev B)</span>
            </a>
            <a class="nav-link text-muted" href="#" title="Dev C/D Scope">
                <i class="bi bi-mic"></i>
                <span>Phòng phỏng vấn (Dev C/D)</span>
            </a>
            <a class="nav-link text-muted" href="#" title="Dev B Scope">
                <i class="bi bi-journal-text"></i>
                <span>Lịch sử & Log (Dev B)</span>
            </a>
        </nav>
        <div class="position-absolute bottom-0 start-0 end-0 p-3 border-top bg-light">
            <div class="d-flex align-items-center justify-content-between mb-1">
                <small class="text-muted fw-semibold">Infra Mode:</small>
                <span class="badge @(AppOptions.Value.InfraMode == "Real" ? "bg-primary" : "bg-warning text-dark")">
                    @AppOptions.Value.InfraMode
                </span>
            </div>
            <div class="d-flex align-items-center justify-content-between">
                <small class="text-muted fw-semibold">Runtime Role:</small>
                <span class="badge bg-secondary">
                    @(Environment.GetEnvironmentVariable("ROLE") ?? AppOptions.Value.Role)
                </span>
            </div>
        </div>
    </aside>

    <!-- Main Content Wrapper -->
    <div class="main-wrapper">
        <header class="topbar">
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted small">Phân hệ:</span>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-semibold">Nhóm 3: Lõi phỏng vấn AI + RAG</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center gap-2 border-end pe-3">
                    <i class="bi bi-person-circle fs-5 text-secondary"></i>
                    <span class="small fw-semibold text-dark">Giảng viên (Giả lập)</span>
                </div>
                <a href="https://github.com" target="_blank" class="text-secondary text-decoration-none">
                    <i class="bi bi-github fs-5"></i>
                </a>
            </div>
        </header>

        <main class="flex-grow-1 p-3">
            @RenderBody()
        </main>

        <footer class="border-top py-3 px-4 bg-white text-muted small text-center">
            &copy; 2026 AI Interview - Nhóm chức năng 3 (PRN222) - Giám khảo ảo AI & RAG Pipeline
        </footer>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
