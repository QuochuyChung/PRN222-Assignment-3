@using Microsoft.Extensions.Options
@using AiInterview.Core.Options
@inject IOptions<AiInterviewOptions> AppOptions
@{
    string currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;
    bool isDashboard = currentPage == "/Index";
    bool isDocuments = currentPage.StartsWith("/Documents");
    string infraMode = AppOptions.Value.InfraMode;
    string runtimeRole = Environment.GetEnvironmentVariable("ROLE") ?? AppOptions.Value.Role;
    string sectionName = ViewData["Section"] as string ?? "Workspace";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · AI Interview</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <!-- Sidebar: fixed on desktop, off-canvas drawer below 992px -->
        <aside class="app-sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="appSidebar" aria-label="Main navigation">
            <div class="d-flex align-items-start justify-content-between">
                <a asp-page="/Index" class="brand">
                    <span class="brand-mark" aria-hidden="true">AI</span>
                    <span>
                        <span class="brand-name d-block">AI Interview</span>
                        <span class="brand-sub">PRN222 · Assignment 3</span>
                    </span>
                </a>
                <button type="button" class="btn-close d-lg-none mt-4 me-3" data-bs-dismiss="offcanvas" data-bs-target="#appSidebar" aria-label="Close menu"></button>
            </div>

            <nav class="side-nav">
                <div class="side-nav-label">Workspace</div>
                <a class="side-link @(isDashboard ? "active" : "")" asp-page="/Index" aria-current="@(isDashboard ? "page" : null)">
                    <i class="bi bi-grid" aria-hidden="true"></i><span>Overview</span>
                </a>
                <a class="side-link @(isDocuments ? "active" : "")" asp-page="/Documents/Index" aria-current="@(isDocuments ? "page" : null)">
                    <i class="bi bi-files" aria-hidden="true"></i><span>Documents</span>
                </a>

                <div class="side-nav-label">Coming later</div>
                <span class="side-link is-disabled" aria-disabled="true">
                    <i class="bi bi-list-check" aria-hidden="true"></i><span>Question bank</span><span class="soon">soon</span>
                </span>
                <span class="side-link is-disabled" aria-disabled="true">
                    <i class="bi bi-mic" aria-hidden="true"></i><span>Interview room</span><span class="soon">soon</span>
                </span>
                <span class="side-link is-disabled" aria-disabled="true">
                    <i class="bi bi-clock-history" aria-hidden="true"></i><span>History &amp; logs</span><span class="soon">soon</span>
                </span>
            </nav>

            <div class="side-footer">
                <dl>
                    <dt>Infra mode</dt>
                    <dd>@infraMode</dd>
                    <dt>Role</dt>
                    <dd>@runtimeRole</dd>
                </dl>
            </div>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <button class="btn btn-line btn-app btn-icon btn-sm d-lg-none" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#appSidebar" aria-controls="appSidebar" aria-label="Open menu">
                    <i class="bi bi-list" aria-hidden="true"></i>
                </button>
                <div class="topbar-crumb">@sectionName / <strong>@ViewData["Title"]</strong></div>
            </header>

            <main class="app-content">
                @RenderBody()
            </main>

            <footer class="app-footer">
                AI Interview · Group 3: interview core &amp; RAG pipeline · PRN222, 2026
            </footer>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
