@{
    var active = ViewData["Active"] as string ?? "";
    string Cls(string key) => active == key ? "active" : "";
    string? Current(string key) => active == key ? "page" : null;
}
<aside id="sidebar" class="sidebar offcanvas-lg offcanvas-start" tabindex="-1" aria-label="Main navigation">
    <div class="sidebar-head">
        <a asp-page="/Index" class="brand">
            <span class="brand-mark" aria-hidden="true"><i class="bi bi-mic-fill"></i></span>
            <span class="brand-text">AI Interview<small>Oral exam assistant</small></span>
        </a>
        <button type="button" class="btn-close d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Close menu"></button>
    </div>

    <nav class="sidebar-nav">
        <div class="nav-label">Prepare</div>
        <a class="nav-item @Cls("dashboard")" aria-current="@Current("dashboard")" asp-page="/Index"><i class="bi bi-grid" aria-hidden="true"></i><span>Dashboard</span></a>
        <a class="nav-item @Cls("documents")" aria-current="@Current("documents")" asp-page="/Documents/Index"><i class="bi bi-files" aria-hidden="true"></i><span>Documents</span></a>
        <a class="nav-item @Cls("questions")" aria-current="@Current("questions")" asp-page="/Questions/Index"><i class="bi bi-patch-question" aria-hidden="true"></i><span>Question bank</span></a>
        <a class="nav-item @Cls("sessions")" aria-current="@Current("sessions")" asp-page="/Sessions/Index"><i class="bi bi-calendar-check" aria-hidden="true"></i><span>Exam sessions</span></a>

        <div class="nav-label">Interview</div>
        <a class="nav-item @Cls("room")" aria-current="@Current("room")" asp-page="/Interview/Room"><i class="bi bi-mic" aria-hidden="true"></i><span>Interview room</span></a>
        <a class="nav-item @Cls("logs")" aria-current="@Current("logs")" asp-page="/Logs/Index"><i class="bi bi-journal-text" aria-hidden="true"></i><span>Session logs</span></a>
    </nav>

    <div class="sidebar-user">
        <span class="avatar" aria-hidden="true">L</span>
        <div class="min-w-0">
            <div class="user-name">Lecturer</div>
            <div class="user-note">Simulated role, no sign-in yet</div>
        </div>
    </div>
</aside>
