@page
@model AiInterview.Web.Pages.Documents.UploadModel
@{
    ViewData["Title"] = "Upload";
    ViewData["Section"] = "Documents";
}

<a asp-page="/Documents/Index" class="back-link">
    <i class="bi bi-arrow-left" aria-hidden="true"></i> Back to documents
</a>

<div class="page-head">
    <div>
        <h1 class="page-title">Upload a document</h1>
        <p class="page-lede">Add course material for the question bank. Processing runs in the background, so you can leave this page right after uploading.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="notice notice-err alert alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button>
    </div>
}

<div class="row g-4">
    <div class="col-12 col-lg-8">
        <section class="panel">
            <div class="panel-body">
                <form method="post" enctype="multipart/form-data" id="uploadForm">
                    <label class="dropzone d-block mb-0" id="dropZone" for="fileInput">
                        <div class="dropzone-icon" aria-hidden="true"><i class="bi bi-cloud-arrow-up"></i></div>
                        <div class="dropzone-title">Drop a file here, or click to browse</div>
                        <div class="dropzone-hint">PDF, PPTX or DOCX · up to 50 MB</div>
                        <span class="btn btn-line btn-app btn-sm">
                            <i class="bi bi-folder2-open" aria-hidden="true"></i><span>Choose file</span>
                        </span>
                        <input type="file" asp-for="UploadFile" class="visually-hidden" id="fileInput" accept=".pdf,.docx,.pptx" />
                    </label>

                    <div id="filePreview" class="file-pill d-none" aria-live="polite">
                        <span class="file-type" id="fileExt" aria-hidden="true">FILE</span>
                        <div class="file-name">
                            <div id="selectedFileName">file</div>
                            <div class="file-meta"><span id="selectedFileSize">0 KB</span></div>
                        </div>
                        <button type="button" class="btn btn-line btn-app btn-icon btn-sm" id="clearFileBtn" aria-label="Remove selected file">
                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                        </button>
                    </div>

                    <p id="clientError" class="error-text d-none mt-3" role="alert"></p>

                    <div class="form-actions">
                        <a asp-page="/Documents/Index" class="btn btn-line btn-app">Cancel</a>
                        <button type="submit" class="btn btn-ink btn-app" id="submitBtn" disabled>
                            <i class="bi bi-upload" aria-hidden="true"></i>
                            <span id="submitBtnText">Upload and process</span>
                        </button>
                    </div>
                </form>
            </div>
        </section>
    </div>

    <div class="col-12 col-lg-4">
        <section class="panel">
            <div class="panel-head"><h2 class="panel-title">What happens next</h2></div>
            <div class="panel-body">
                <ol class="pipeline">
                    <li><div><strong>Store</strong>The file is saved to object storage.</div></li>
                    <li><div><strong>Queue</strong>A job is added to the document stream.</div></li>
                    <li><div><strong>Extract</strong>Text is read slide by slide or page by page.</div></li>
                    <li><div><strong>Chunk &amp; embed</strong>Text is split into chunks and embedded with Gemini.</div></li>
                    <li><div><strong>Index</strong>Vectors are written to Qdrant for retrieval.</div></li>
                </ol>
                <div class="notice notice-info mt-4 mb-0">
                    <i class="bi bi-info-circle" aria-hidden="true"></i>
                    <div>Scanned PDFs (images with no text layer) are rejected and marked <code>Failed</code>.</div>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const MAX_BYTES = 50 * 1024 * 1024;
            const ALLOWED = ["pdf", "docx", "pptx"];

            const dropZone = document.getElementById("dropZone");
            const fileInput = document.getElementById("fileInput");
            const filePreview = document.getElementById("filePreview");
            const fileExt = document.getElementById("fileExt");
            const selectedFileName = document.getElementById("selectedFileName");
            const selectedFileSize = document.getElementById("selectedFileSize");
            const clientError = document.getElementById("clientError");
            const submitBtn = document.getElementById("submitBtn");
            const submitBtnText = document.getElementById("submitBtnText");
            const uploadForm = document.getElementById("uploadForm");
            const clearFileBtn = document.getElementById("clearFileBtn");

            ["dragenter", "dragover"].forEach(name => dropZone.addEventListener(name, e => {
                e.preventDefault();
                dropZone.classList.add("is-over");
            }));

            ["dragleave", "drop"].forEach(name => dropZone.addEventListener(name, e => {
                e.preventDefault();
                dropZone.classList.remove("is-over");
            }));

            dropZone.addEventListener("drop", e => {
                const files = e.dataTransfer.files;
                if (files.length > 0) {
                    fileInput.files = files;
                    handleFileSelect(files[0]);
                }
            });

            fileInput.addEventListener("change", () => {
                if (fileInput.files.length > 0) handleFileSelect(fileInput.files[0]);
            });

            clearFileBtn.addEventListener("click", clearSelectedFile);

            function showError(message) {
                clientError.textContent = message;
                clientError.classList.toggle("d-none", !message);
            }

            function handleFileSelect(file) {
                const ext = file.name.includes(".") ? file.name.split(".").pop().toLowerCase() : "";

                if (!ALLOWED.includes(ext)) {
                    clearSelectedFile();
                    showError(`"${file.name}" is not supported. Choose a PDF, PPTX or DOCX file.`);
                    return;
                }
                if (file.size > MAX_BYTES) {
                    clearSelectedFile();
                    showError(`"${file.name}" is larger than 50 MB.`);
                    return;
                }

                showError("");
                fileExt.textContent = ext.toUpperCase();
                fileExt.dataset.ext = ext;
                selectedFileName.textContent = file.name;
                selectedFileSize.textContent = window.aiInterview.formatSize(file.size);
                filePreview.classList.remove("d-none");
                submitBtn.disabled = false;
            }

            function clearSelectedFile() {
                fileInput.value = "";
                filePreview.classList.add("d-none");
                submitBtn.disabled = true;
            }

            uploadForm.addEventListener("submit", () => {
                submitBtn.disabled = true;
                submitBtnText.textContent = "Uploading…";
            });
        })();
    </script>
}
