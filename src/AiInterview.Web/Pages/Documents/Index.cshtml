@page
@model AiInterview.Web.Pages.Documents.IndexModel
@using AiInterview.Core.Models
@{
    ViewData["Title"] = "Documents";
    ViewData["Section"] = "Workspace";

    int total = Model.Documents.Count;
    int ready = Model.Documents.Count(d => d.Status == DocumentStatus.Success);
    int processing = Model.Documents.Count(d => d.Status == DocumentStatus.Processing);
    int failed = Model.Documents.Count(d => d.Status == DocumentStatus.Failed);

    static string FormatSize(long bytes)
    {
        double kb = bytes / 1024.0;
        return kb >= 1024 ? $"{kb / 1024.0:F2} MB" : $"{kb:F1} KB";
    }
}

<div class="page-head">
    <div>
        <h1 class="page-title">Course documents</h1>
        <p class="page-lede">
            Slides, handouts and textbooks that the question bank draws from.
            Each file is extracted, chunked, embedded and indexed in the background.
        </p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn btn-line btn-app btn-icon" onclick="location.reload();" title="Refresh" aria-label="Refresh list">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i>
        </button>
        <a asp-page="/Documents/Upload" class="btn btn-ink btn-app">
            <i class="bi bi-upload" aria-hidden="true"></i><span>Upload document</span>
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="notice notice-ok alert alert-dismissible fade show" role="status">
        <i class="bi bi-check2-circle" aria-hidden="true"></i>
        <div>@Model.StatusMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button>
    </div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="notice notice-err alert alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
        <div>@Model.ErrorMessage</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button>
    </div>
}

<div class="stat-row" aria-label="Summary">
    <div class="stat"><div class="stat-label">Total</div><div class="stat-value" id="statTotal">@total</div></div>
    <div class="stat"><div class="stat-label">Indexed</div><div class="stat-value" id="statReady">@ready</div></div>
    <div class="stat"><div class="stat-label">Processing</div><div class="stat-value" id="statProcessing">@processing</div></div>
    <div class="stat"><div class="stat-label">Failed</div><div class="stat-value" id="statFailed">@failed</div></div>
</div>

<section class="panel" aria-labelledby="docsTitle">
    <div class="panel-head">
        <h2 class="panel-title" id="docsTitle">All documents</h2>
        <span class="live" id="liveStatus" data-state="connecting" aria-live="polite">
            <span class="live-dot" aria-hidden="true"></span>
            <span id="liveText">Connecting to live updates…</span>
        </span>
    </div>

    @if (total == 0)
    {
        <div class="empty">
            <div class="empty-art" aria-hidden="true"><i class="bi bi-file-earmark-plus"></i></div>
            <h2>No documents yet</h2>
            <p>Upload lecture slides (PPTX), a textbook (PDF) or notes (DOCX) to start building the question bank.</p>
            <a asp-page="/Documents/Upload" class="btn btn-ink btn-app">
                <i class="bi bi-upload" aria-hidden="true"></i><span>Upload your first document</span>
            </a>
        </div>
    }
    else
    {
        <table class="doc-table" id="documentsTable">
            <thead>
                <tr>
                    <th scope="col">Document</th>
                    <th scope="col">Size</th>
                    <th scope="col">Pages</th>
                    <th scope="col">Chunks</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="col-actions"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var doc in Model.Documents)
                {
                    string ext = System.IO.Path.GetExtension(doc.FileName).TrimStart('.').ToLowerInvariant();

                    <tr id="doc-row-@doc.Id" data-document-id="@doc.Id" data-status="@doc.Status">
                        <td class="col-file">
                            <div class="file-cell">
                                <span class="file-type" data-ext="@ext" aria-hidden="true">@ext.ToUpperInvariant()</span>
                                <div class="min-w-0">
                                    <div class="file-name">@doc.FileName</div>
                                    <div class="file-meta">
                                        <span title="Uploaded (UTC)">@doc.UploadedAt.ToString("dd MMM yyyy, HH:mm") UTC</span>
                                        <span class="mono" title="Document ID">@doc.Id[..Math.Min(8, doc.Id.Length)]</span>
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td data-label="Size" class="num">@FormatSize(doc.Size)</td>
                        <td data-label="Pages" class="num page-count">@(doc.PageCount > 0 ? doc.PageCount.ToString() : "–")</td>
                        <td data-label="Chunks" class="num chunk-count">@(doc.ChunkCount > 0 ? doc.ChunkCount.ToString() : "–")</td>
                        <td data-label="Status" class="col-status">
                            <div class="status-container">
                                @if (doc.Status == DocumentStatus.Success)
                                {
                                    <span class="chip chip-ok">Indexed</span>
                                }
                                else if (doc.Status == DocumentStatus.Processing)
                                {
                                    <span class="chip chip-warn">Processing</span>
                                    <div class="meter" role="progressbar" aria-label="Processing progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="5">
                                        <div class="meter-fill"></div>
                                    </div>
                                    <span class="step-text">Queued</span>
                                }
                                else if (doc.Status == DocumentStatus.Failed)
                                {
                                    <span class="chip chip-err">Failed</span>
                                    @if (!string.IsNullOrEmpty(doc.ErrorMessage))
                                    {
                                        <span class="error-text">@doc.ErrorMessage</span>
                                    }
                                }
                                else
                                {
                                    <span class="chip chip-muted">@doc.Status</span>
                                }
                            </div>
                        </td>
                        <td class="col-actions">
                            <div class="row-actions">
                                <form method="post" asp-page-handler="Reindex" asp-route-documentId="@doc.Id">
                                    <button type="submit" class="btn btn-line btn-app btn-sm" title="Run extraction and embedding again">
                                        <i class="bi bi-arrow-repeat" aria-hidden="true"></i><span>Re-index</span>
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="Delete" asp-route-documentId="@doc.Id"
                                      onsubmit="return confirm('Delete this document and all of its vectors? This cannot be undone.');">
                                    <button type="submit" class="btn btn-danger-line btn-app btn-sm" title="Delete document and vectors" aria-label="Delete @doc.FileName">
                                        <i class="bi bi-trash3" aria-hidden="true"></i><span class="d-md-none">Delete</span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const { escapeHtml } = window.aiInterview;
            const liveStatus = document.getElementById("liveStatus");
            const liveText = document.getElementById("liveText");
            const POLL_INTERVAL_MS = 3000;
            let pollTimer = null;

            function setLiveState(state, text) {
                if (!liveStatus) return;
                liveStatus.dataset.state = state;
                liveText.textContent = text;
            }

            // ---- Polling fallback (used whenever SignalR is not connected) ----
            function startPollingFallback() {
                if (pollTimer) return;
                setLiveState("polling", "Live updates offline · checking every 3 s");
                pollTimer = setInterval(pollProcessingRows, POLL_INTERVAL_MS);
                pollProcessingRows();
            }

            function stopPollingFallback() {
                if (!pollTimer) return;
                clearInterval(pollTimer);
                pollTimer = null;
            }

            function pollProcessingRows() {
                document.querySelectorAll('tr[data-document-id][data-status="Processing"]').forEach(row => {
                    const docId = row.dataset.documentId;
                    fetch(`/api/documents/${encodeURIComponent(docId)}/status`)
                        .then(res => res.ok ? res.json() : null)
                        .then(data => { if (data) updateDocumentRow(data); })
                        .catch(() => { /* keep polling */ });
                });
            }

            // ---- SignalR ----
            if (typeof signalR === "undefined") {
                startPollingFallback();
                return;
            }

            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/document")
                .withAutomaticReconnect()
                .build();

            connection.on("DocumentStatusChanged", updateDocumentRow);
            connection.on("DocumentProgress", updateDocumentProgress);

            connection.onreconnecting(() => startPollingFallback());
            connection.onreconnected(() => {
                stopPollingFallback();
                setLiveState("connected", "Live updates on");
                pollProcessingRows(); // catch up on anything missed while offline
            });
            connection.onclose(() => startPollingFallback());

            connection.start()
                .then(() => {
                    setLiveState("connected", "Live updates on");
                    // Events sent before the connection opened are lost, so sync once now.
                    pollProcessingRows();
                })
                .catch(err => {
                    console.warn("SignalR connection failed:", err);
                    startPollingFallback();
                });

            // ---- Row rendering ----
            function renderStatus(data) {
                if (data.status === "Success") {
                    return `<span class="chip chip-ok">Indexed</span>`;
                }
                if (data.status === "Failed") {
                    const err = data.errorMessage ? `<span class="error-text">${escapeHtml(data.errorMessage)}</span>` : "";
                    return `<span class="chip chip-err">Failed</span>${err}`;
                }
                if (data.status === "Processing") {
                    return `
                        <span class="chip chip-warn">Processing</span>
                        <div class="meter" role="progressbar" aria-label="Processing progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="5">
                            <div class="meter-fill"></div>
                        </div>
                        <span class="step-text">Queued</span>`;
                }
                return `<span class="chip chip-muted">${escapeHtml(data.status)}</span>`;
            }

            function updateDocumentRow(data) {
                const row = document.getElementById("doc-row-" + data.documentId);

                if (data.status === "Deleted") {
                    if (row) row.remove();
                    refreshStats();
                    return;
                }

                if (!row) {
                    // Uploaded from another tab: reload to show the new row.
                    location.reload();
                    return;
                }

                const pageCountEl = row.querySelector(".page-count");
                const chunkCountEl = row.querySelector(".chunk-count");
                const statusContainer = row.querySelector(".status-container");

                if (pageCountEl && data.pageCount > 0) pageCountEl.textContent = data.pageCount;
                if (chunkCountEl && data.chunkCount > 0) chunkCountEl.textContent = data.chunkCount;

                if (row.dataset.status !== data.status || data.status !== "Processing") {
                    row.dataset.status = data.status;
                    if (statusContainer) statusContainer.innerHTML = renderStatus(data);
                }
                refreshStats();
            }

            function updateDocumentProgress(data) {
                const row = document.getElementById("doc-row-" + data.documentId);
                if (!row || row.dataset.status !== "Processing") return;

                const meter = row.querySelector(".meter");
                const fill = row.querySelector(".meter-fill");
                const stepText = row.querySelector(".step-text");

                if (fill) fill.style.width = data.percent + "%";
                if (meter) meter.setAttribute("aria-valuenow", data.percent);
                if (stepText) stepText.textContent = `${data.step} · ${data.percent}%`;
            }

            function refreshStats() {
                const rows = [...document.querySelectorAll("tr[data-document-id]")];
                const count = s => rows.filter(r => r.dataset.status === s).length;
                const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
                set("statTotal", rows.length);
                set("statReady", count("Success"));
                set("statProcessing", count("Processing"));
                set("statFailed", count("Failed"));
            }
        });
    </script>
}
