@page
@model AiInterview.Web.Pages.Documents.IndexModel
@{
    ViewData["Title"] = "Quản lý Tài liệu Môn học";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">
                <i class="bi bi-folder2-open text-primary me-2"></i>Quản lý Tài liệu & Ingestion
            </h1>
            <p class="text-muted mb-0">
                Tải lên tài liệu (.pptx, .pdf, .docx), tự động trích xuất văn bản, phân đoạn (chunking), tạo embedding và lưu trữ vector Qdrant.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/Documents/Upload" class="btn btn-primary d-flex align-items-center gap-2">
                <i class="bi bi-cloud-arrow-up-fill"></i>
                <span>Tải lên tài liệu mới</span>
            </a>
            <button class="btn btn-outline-secondary" onclick="location.reload();" title="Làm mới trang">
                <i class="bi bi-arrow-clockwise"></i>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@Model.StatusMessage</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@Model.ErrorMessage</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Live Ingestion Status Banner -->
    <div class="card shadow-sm border-0 mb-4 bg-light">
        <div class="card-body d-flex justify-content-between align-items-center py-2 px-3">
            <div class="d-flex align-items-center gap-2">
                <span class="spinner-grow spinner-grow-sm text-success" id="signalrIndicator" role="status"></span>
                <span class="small fw-semibold text-secondary" id="signalrText">SignalR: Đang kết nối cập nhật tiến độ theo thời gian thực...</span>
            </div>
            <span class="badge bg-secondary" id="totalDocsBadge">Tổng: @Model.Documents.Count tài liệu</span>
        </div>
    </div>

    <!-- Documents Table Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.Documents.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-file-earmark-arrow-up display-1 text-muted opacity-50"></i>
                    <h5 class="mt-3 text-muted">Chưa có tài liệu nào trong hệ thống</h5>
                    <p class="text-secondary small">Hãy tải lên slide bài giảng PPTX, giáo trình PDF hoặc tài liệu Word DOCX để bắt đầu.</p>
                    <a asp-page="/Documents/Upload" class="btn btn-primary mt-2">
                        <i class="bi bi-upload me-1"></i> Tải tài liệu đầu tiên
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="documentsTable">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 35%;">Tên tài liệu</th>
                                <th style="width: 12%;">Dung lượng</th>
                                <th style="width: 10%;">Số trang / slide</th>
                                <th style="width: 10%;">Số Chunk</th>
                                <th style="width: 18%;">Trạng thái Ingestion</th>
                                <th style="width: 15%; text-align: right;">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in Model.Documents)
                            {
                                string ext = System.IO.Path.GetExtension(doc.FileName).ToLowerInvariant();
                                string iconClass = ext switch
                                {
                                    ".pdf" => "bi-filetype-pdf text-danger",
                                    ".pptx" => "bi-filetype-pptx text-warning",
                                    ".docx" => "bi-filetype-docx text-primary",
                                    _ => "bi-file-earmark-text text-secondary"
                                };

                                string rowId = $"doc-row-{doc.Id}";

                                <tr id="@rowId" data-document-id="@doc.Id">
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="bi @iconClass fs-2 me-3"></i>
                                            <div>
                                                <div class="fw-bold text-dark text-break">@doc.FileName</div>
                                                <small class="text-muted d-block font-monospace" style="font-size: 0.75rem;">ID: @doc.Id</small>
                                                <small class="text-secondary" style="font-size: 0.75rem;">
                                                    <i class="bi bi-clock me-1"></i>@doc.UploadedAt.ToString("dd/MM/yyyy HH:mm:ss") UTC
                                                </small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @{
                                            double sizeKb = doc.Size / 1024.0;
                                            string sizeText = sizeKb > 1024 ? $"{(sizeKb / 1024.0):F2} MB" : $"{sizeKb:F1} KB";
                                        }
                                        <span class="badge bg-light text-dark border">@sizeText</span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold page-count">@(doc.PageCount > 0 ? doc.PageCount.ToString() : "-")</span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold chunk-count">@(doc.ChunkCount > 0 ? doc.ChunkCount.ToString() : "-")</span>
                                    </td>
                                    <td>
                                        <div class="status-container">
                                            @if (doc.Status == AiInterview.Core.Models.DocumentStatus.Success)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle py-1 px-2 d-inline-flex align-items-center gap-1">
                                                    <i class="bi bi-check-circle-fill"></i> Hoàn thành
                                                </span>
                                            }
                                            else if (doc.Status == AiInterview.Core.Models.DocumentStatus.Processing)
                                            {
                                                <div>
                                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle py-1 px-2 d-inline-flex align-items-center gap-1">
                                                        <span class="spinner-border spinner-border-sm" role="status"></span> Đang xử lý
                                                    </span>
                                                    <div class="progress mt-1" style="height: 6px; width: 140px;">
                                                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-warning" role="progressbar" style="width: 50%"></div>
                                                    </div>
                                                    <small class="text-muted step-text" style="font-size: 0.7rem;">Đang phân tích...</small>
                                                </div>
                                            }
                                            else if (doc.Status == AiInterview.Core.Models.DocumentStatus.Failed)
                                            {
                                                <div>
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle py-1 px-2 d-inline-flex align-items-center gap-1">
                                                        <i class="bi bi-x-circle-fill"></i> Thất bại
                                                    </span>
                                                    @if (!string.IsNullOrEmpty(doc.ErrorMessage))
                                                    {
                                                        <small class="d-block text-danger mt-1 text-truncate" style="max-width: 220px;" title="@doc.ErrorMessage">
                                                            <i class="bi bi-info-circle me-1"></i>@doc.ErrorMessage
                                                        </small>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle py-1 px-2">
                                                    @doc.Status
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <form method="post" asp-page-handler="Reindex" asp-route-documentId="@doc.Id" class="d-inline">
                                                <button type="submit" class="btn btn-outline-primary" title="Xử lý lại (Re-index)">
                                                    <i class="bi bi-arrow-repeat"></i> Re-index
                                                </button>
                                            </form>
                                            <form method="post" asp-page-handler="Delete" asp-route-documentId="@doc.Id" class="d-inline ms-1" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tài liệu này cùng toàn bộ vector embeddings liên quan không?');">
                                                <button type="submit" class="btn btn-outline-danger" title="Xóa tài liệu và vector">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Setup SignalR connection for Realtime Ingestion updates
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/document")
                .withAutomaticReconnect()
                .build();

            const indicator = document.getElementById("signalrIndicator");
            const indicatorText = document.getElementById("signalrText");

            connection.start().then(() => {
                if (indicator) {
                    indicator.classList.remove("text-secondary", "spinner-grow-sm");
                    indicator.classList.add("text-success");
                }
                if (indicatorText) {
                    indicatorText.textContent = "SignalR: Đã kết nối thời gian thực (Realtime Ingestion)";
                    indicatorText.classList.remove("text-secondary");
                    indicatorText.classList.add("text-success");
                }
            }).catch(err => {
                console.warn("SignalR connection error:", err);
                if (indicatorText) {
                    indicatorText.textContent = "SignalR: Kết nối ngoại tuyến. Sử dụng tự động kiểm tra trạng thái.";
                }
            });

            // Listen for document status changes
            connection.on("DocumentStatusChanged", function (data) {
                console.log("DocumentStatusChanged event:", data);
                updateDocumentRow(data);
            });

            // Listen for document progress
            connection.on("DocumentProgress", function (data) {
                console.log("DocumentProgress event:", data);
                updateDocumentProgress(data);
            });

            function updateDocumentRow(data) {
                const row = document.getElementById("doc-row-" + data.documentId);
                if (!row) {
                    // Document might have just been uploaded from another tab, reload to reflect
                    location.reload();
                    return;
                }

                if (data.status === "Deleted") {
                    row.remove();
                    return;
                }

                const pageCountEl = row.querySelector(".page-count");
                const chunkCountEl = row.querySelector(".chunk-count");
                const statusContainer = row.querySelector(".status-container");

                if (pageCountEl && data.pageCount > 0) pageCountEl.textContent = data.pageCount;
                if (chunkCountEl && data.chunkCount > 0) chunkCountEl.textContent = data.chunkCount;

                if (statusContainer) {
                    if (data.status === "Success") {
                        statusContainer.innerHTML = `
                            <span class="badge bg-success-subtle text-success border border-success-subtle py-1 px-2 d-inline-flex align-items-center gap-1">
                                <i class="bi bi-check-circle-fill"></i> Hoàn thành
                            </span>
                        `;
                    } else if (data.status === "Failed") {
                        const errMsg = data.errorMessage ? `<small class="d-block text-danger mt-1 text-truncate" style="max-width: 220px;" title="${data.errorMessage}"><i class="bi bi-info-circle me-1"></i>${data.errorMessage}</small>` : '';
                        statusContainer.innerHTML = `
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle py-1 px-2 d-inline-flex align-items-center gap-1">
                                <i class="bi bi-x-circle-fill"></i> Thất bại
                            </span>
                            ${errMsg}
                        `;
                    } else if (data.status === "Processing") {
                        statusContainer.innerHTML = `
                            <div>
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle py-1 px-2 d-inline-flex align-items-center gap-1">
                                    <span class="spinner-border spinner-border-sm" role="status"></span> Đang xử lý
                                </span>
                                <div class="progress mt-1" style="height: 6px; width: 140px;">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-warning" role="progressbar" style="width: 50%"></div>
                                </div>
                                <small class="text-muted step-text" style="font-size: 0.7rem;">Đang phân tích...</small>
                            </div>
                        `;
                    }
                }
            }

            function updateDocumentProgress(data) {
                const row = document.getElementById("doc-row-" + data.documentId);
                if (!row) return;

                const progressBar = row.querySelector(".progress-bar");
                const stepText = row.querySelector(".step-text");

                if (progressBar) {
                    progressBar.style.width = data.percent + "%";
                }
                if (stepText) {
                    stepText.textContent = data.step + ` (${data.percent}%)`;
                }
            }
        });
    </script>
}

