@page
@model IndexModel
@{
    ViewData["Title"] = "Overview";
}

<div class="page-head">
    <div>
        <div class="eyebrow">Group 3 · Interview core + RAG</div>
        <h1 class="page-title">AI Interview</h1>
        <p class="page-lede">
            A virtual oral examiner: it reads questions aloud, listens to answers, asks follow-ups,
            and builds its question bank from your course material.
        </p>
    </div>
    <div class="page-actions">
        <a asp-page="/Documents/Upload" class="btn btn-ink btn-app">
            <i class="bi bi-upload" aria-hidden="true"></i><span>Upload material</span>
        </a>
    </div>
</div>

<section class="panel" aria-labelledby="modulesTitle">
    <div class="panel-head">
        <h2 class="panel-title" id="modulesTitle">Modules</h2>
        <span class="live" data-state="connected"><span class="live-dot"></span>1 of 4 live</span>
    </div>
    <div class="module-list">
        <article class="module">
            <div class="module-top">
                <span class="module-owner">Dev A</span>
                <span class="chip chip-ok">Live</span>
            </div>
            <h3>Document ingestion</h3>
            <p>Upload PPTX, PDF or DOCX. Text is extracted, chunked, embedded with Gemini and stored in Qdrant.</p>
            <a asp-page="/Documents/Index" class="btn btn-line btn-app btn-sm">
                <span>Open documents</span><i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
        </article>

        <article class="module">
            <div class="module-top">
                <span class="module-owner">Dev B</span>
                <span class="chip chip-muted">Planned</span>
            </div>
            <h3>Question bank</h3>
            <p>Retrieves chunks from Qdrant and drafts questions by Bloom level for instructors to review and edit.</p>
        </article>

        <article class="module">
            <div class="module-top">
                <span class="module-owner">Dev C</span>
                <span class="chip chip-muted">Planned</span>
            </div>
            <h3>Interview engine</h3>
            <p>Session state machine backed by Redis, LLM follow-up questions and hard time limits.</p>
        </article>

        <article class="module">
            <div class="module-top">
                <span class="module-owner">Dev D</span>
                <span class="chip chip-muted">Planned</span>
            </div>
            <h3>Interview room</h3>
            <p>Voice interface with text-to-speech prompts, speech-to-text answers and a live countdown.</p>
        </article>
    </div>
</section>
