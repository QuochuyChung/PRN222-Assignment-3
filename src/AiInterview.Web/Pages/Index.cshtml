@page
@model IndexModel
@{
    ViewData["Title"] = "AI Interview Dashboard";
}

<div class="container-fluid py-3">
    <!-- Welcome Hero -->
    <div class="p-4 mb-4 bg-primary text-white rounded-3 shadow-sm d-flex justify-content-between align-items-center">
        <div>
            <h1 class="display-6 fw-bold mb-2">Hệ thống Phỏng vấn Ảo AI</h1>
            <p class="fs-6 mb-0 opacity-75">
                Nhóm 3: Lõi phỏng vấn AI + RAG (Đọc câu hỏi TTS, STT, hỏi xoáy phỏng vấn, trích xuất tài liệu)
            </p>
        </div>
        <div class="d-none d-md-block text-end">
            <span class="badge bg-light text-primary fs-6 px-3 py-2">PRN222 Assignment 3</span>
        </div>
    </div>

    <!-- Quick Cards Row -->
    <div class="row g-4 mb-4">
        <!-- Dev A: Document Ingestion -->
        <div class="col-md-6 col-xl-3">
            <div class="card h-100 shadow-sm border-0 border-start border-primary border-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="text-muted small fw-semibold">DEV A — MODULE</span>
                        <span class="badge bg-primary-subtle text-primary">Sẵn sàng</span>
                    </div>
                    <h5 class="card-title fw-bold">Document Ingestion</h5>
                    <p class="card-text text-secondary small">
                        Upload PPTX/PDF/DOCX, trích xuất text, chunking, Gemini embedding và Qdrant vector store.
                    </p>
                    <a asp-page="/Documents/Index" class="btn btn-sm btn-primary">
                        <i class="bi bi-arrow-right me-1"></i> Quản lý tài liệu
                    </a>
                </div>
            </div>
        </div>

        <!-- Dev B: Question Bank -->
        <div class="col-md-6 col-xl-3">
            <div class="card h-100 shadow-sm border-0 border-start border-info border-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="text-muted small fw-semibold">DEV B — MODULE</span>
                        <span class="badge bg-secondary-subtle text-secondary">Đang chờ</span>
                    </div>
                    <h5 class="card-title fw-bold">Ngân hàng câu hỏi</h5>
                    <p class="card-text text-secondary small">
                        Truy xuất chunk từ Qdrant, sinh câu hỏi bằng LLM theo thang Bloom, duyệt & sửa câu hỏi.
                    </p>
                    <button class="btn btn-sm btn-outline-secondary" disabled>Chờ Dev B</button>
                </div>
            </div>
        </div>

        <!-- Dev C: Interview Engine -->
        <div class="col-md-6 col-xl-3">
            <div class="card h-100 shadow-sm border-0 border-start border-warning border-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="text-muted small fw-semibold">DEV C — MODULE</span>
                        <span class="badge bg-secondary-subtle text-secondary">Đang chờ</span>
                    </div>
                    <h5 class="card-title fw-bold">Interview Engine</h5>
                    <p class="card-text text-secondary small">
                        State machine phiên thi, quản lý state Redis, hỏi xoáy bằng LLM, luật cứng thời gian.
                    </p>
                    <button class="btn btn-sm btn-outline-secondary" disabled>Chờ Dev C</button>
                </div>
            </div>
        </div>

        <!-- Dev D: Interview UI -->
        <div class="col-md-6 col-xl-3">
            <div class="card h-100 shadow-sm border-0 border-start border-success border-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="text-muted small fw-semibold">DEV D — MODULE</span>
                        <span class="badge bg-secondary-subtle text-secondary">Đang chờ</span>
                    </div>
                    <h5 class="card-title fw-bold">Phòng phỏng vấn</h5>
                    <p class="card-text text-secondary small">
                        Giao diện tương tác giọng nói, TTS đọc đề, STT nhận diện câu trả lời, live countdown.
                    </p>
                    <button class="btn btn-sm btn-outline-secondary" disabled>Chờ Dev D</button>
                </div>
            </div>
        </div>
    </div>
</div>
