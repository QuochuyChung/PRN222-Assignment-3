@page
@model IndexModel
@using AiInterview.Common.Configuration
@inject InfraOptions Infra
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Active"] = "dashboard";
    var s = Model.Summary;
}

<div class="page-head">
    <div>
        <p class="eyebrow">Overview</p>
        <h1 class="page-title">Dashboard</h1>
        <p class="page-lead">Voice-based oral exams: documents in, questions out, follow-ups when an answer is vague.</p>
    </div>
    <a class="btn btn-accent" asp-page="/Documents/Index"><i class="bi bi-upload" aria-hidden="true"></i> Upload material</a>
</div>

<div class="stats">
    <div class="stat intro">
        <span class="mode">@Infra.Mode mode</span>
        <h2>An AI examiner for oral tests</h2>
        <p>Questions come from your course material. The AI asks a follow-up when an answer is still unclear.</p>
        <a asp-page="/Interview/Room">Open the interview room <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
    </div>
    <div class="stat">
        <div class="stat-label">Processed documents</div>
        <div class="stat-value">@s.ProcessedDocuments<small>/@s.TotalDocuments</small></div>
    </div>
    <div class="stat">
        <div class="stat-label">Approved questions</div>
        <div class="stat-value">@s.ApprovedQuestions</div>
        <div class="stat-note">@s.DraftQuestions drafts waiting for review</div>
    </div>
    <div class="stat">
        <div class="stat-label">Completed sessions</div>
        <div class="stat-value">@s.CompletedSessions<small>/@s.TotalSessions</small></div>
        <div class="stat-note">@s.TotalTurns question and answer turns</div>
    </div>
</div>

<section class="panel">
    <div class="panel-head">
        <h2 class="panel-title">Recent turns</h2>
        <a class="btn btn-line btn-sm" asp-page="/Logs/Index">View logs</a>
    </div>
    @if (s.RecentTurns.Count == 0)
    {
        <div class="empty"><i class="bi bi-chat-square-text" aria-hidden="true"></i><p>No turns yet.</p></div>
    }
    else
    {
        <table class="table-stack">
            <thead><tr><th scope="col">Type</th><th scope="col">Question</th><th scope="col">Answer</th><th scope="col">Ended</th></tr></thead>
            <tbody>
            @foreach (var t in s.RecentTurns)
            {
                <tr>
                    <td data-label="Type">
                        @if (t.IsFollowUp)
                        {
                            <span class="status status-processing">Follow-up</span>
                        }
                        else
                        {
                            <span class="chip">Main question</span>
                        }
                    </td>
                    <td data-label="Question"><div class="truncate" title="@t.QuestionText">@t.QuestionText</div></td>
                    <td data-label="Answer"><div class="truncate text-secondary" title="@t.TranscriptPreview">@t.TranscriptPreview</div></td>
                    <td data-label="Ended" class="text-nowrap mono">@t.EndedAt.ToString("dd/MM HH:mm") UTC</td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>
