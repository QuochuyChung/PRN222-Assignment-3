@page
@model AiInterview.Web.Pages.Sessions.IndexModel
@using AiInterview.Common.Enums
@{
    ViewData["Title"] = "Phiên phỏng vấn";
    ViewData["Active"] = "sessions";
}

<div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Phiên phỏng vấn</h2>
        <div class="small text-secondary">Tạo mới, quản lý các phiên thi vấn đáp AI và kiểm tra thiết bị mic.</div>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#testMicModal">
            <i class="bi bi-mic-fill me-1 text-danger"></i> Kiểm tra Mic
        </button>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createSessionModal">
            <i class="bi bi-plus-lg me-1"></i> Tạo phiên thi mới
        </button>
    </div>
</div>

<!-- Thống kê nhanh -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-primary bg-opacity-10 text-primary fs-3">
                    <i class="bi bi-collection-play"></i>
                </div>
                <div>
                    <div class="small text-secondary fw-medium">Tổng phiên thi</div>
                    <div class="fs-4 fw-bold">@Model.Sessions.Count</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-success bg-opacity-10 text-success fs-3">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
                <div>
                    <div class="small text-secondary fw-medium">Đã hoàn thành</div>
                    <div class="fs-4 fw-bold">@Model.Sessions.Count(s => s.Status == SessionStatus.Completed)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-warning bg-opacity-10 text-warning fs-3">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div>
                    <div class="small text-secondary fw-medium">Đang diễn ra</div>
                    <div class="fs-4 fw-bold">@Model.Sessions.Count(s => s.Status == SessionStatus.InProgress)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-info bg-opacity-10 text-info fs-3">
                    <i class="bi bi-person-badge"></i>
                </div>
                <div>
                    <div class="small text-secondary fw-medium">Mới sẵn sàng</div>
                    <div class="fs-4 fw-bold">@Model.Sessions.Count(s => s.Status == SessionStatus.Created)</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Danh sách các phiên thi -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">Danh sách các phiên phỏng vấn</h5>
        <span class="badge text-bg-light border">@Model.Sessions.Count phiên</span>
    </div>
    <div class="card-body p-4">
        @if (Model.Sessions.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-folder2-open display-4 text-muted"></i>
                <div class="mt-3 text-secondary">Chưa có phiên phỏng vấn nào. Hãy nhấn <strong>"Tạo phiên thi mới"</strong> để bắt đầu!</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Trạng thái</th>
                            <th>Tiêu đề phiên thi</th>
                            <th>Thí sinh</th>
                            <th>Cấu hình</th>
                            <th>Thời gian tạo</th>
                            <th class="text-end pe-3">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Sessions)
                        {
                            <tr>
                                <td class="ps-3">
                                    @switch (s.Status)
                                    {
                                        case SessionStatus.Created:
                                            <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25">
                                                <i class="bi bi-circle-fill me-1 small"></i> Mới tạo
                                            </span>
                                            break;
                                        case SessionStatus.InProgress:
                                            <span class="badge rounded-pill bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25">
                                                <i class="bi bi-play-circle me-1 small"></i> Đang thi
                                            </span>
                                            break;
                                        case SessionStatus.Completed:
                                            <span class="badge rounded-pill bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                                <i class="bi bi-check2-circle me-1 small"></i> Hoàn thành
                                            </span>
                                            break;
                                        default:
                                            <span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary border">
                                                @s.Status
                                            </span>
                                            break;
                                    }
                                </td>
                                <td class="fw-semibold">
                                    @s.Title
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle bg-light text-primary fw-bold">
                                            @(string.IsNullOrWhiteSpace(s.StudentName) ? "T" : s.StudentName[0].ToString().ToUpper())
                                        </div>
                                        <span>@s.StudentName</span>
                                    </div>
                                </td>
                                <td class="small text-secondary">
                                    <div><i class="bi bi-patch-question me-1"></i> @s.QuestionCount câu hỏi</div>
                                    <div><i class="bi bi-arrow-repeat me-1"></i> Tối đa @s.MaxFollowUps lần hỏi xoáy/câu</div>
                                    <div><i class="bi bi-stopwatch me-1"></i> @s.AnswerSeconds giây/câu</div>
                                </td>
                                <td class="small text-secondary">
                                    @s.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-page="/Interview/Room" asp-route-sessionId="@s.Id" class="btn btn-sm @(s.Status == SessionStatus.Completed ? "btn-outline-secondary" : "btn-primary")">
                                        <i class="bi bi-door-open-fill me-1"></i>
                                        @(s.Status == SessionStatus.Completed ? "Xem lại phòng" : (s.Status == SessionStatus.InProgress ? "Tiếp tục thi" : "Bắt đầu thi"))
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal Tạo Phiên Thi Mới -->
<div class="modal fade" id="createSessionModal" tabindex="-1" aria-labelledby="createSessionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="createSessionModalLabel">
                        <i class="bi bi-plus-circle text-primary me-2"></i> Tạo phiên phỏng vấn mới
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên thí sinh / Ứng viên <span class="text-danger">*</span></label>
                        <input type="text" asp-for="Form.StudentName" class="form-control" placeholder="Ví dụ: Nguyễn Văn An" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tiêu đề buổi phỏng vấn <span class="text-danger">*</span></label>
                        <input type="text" asp-for="Form.Title" class="form-control" placeholder="Ví dụ: Vấn đáp môn PRN222 - C# & ASP.NET" required />
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Số câu hỏi</label>
                            <input type="number" asp-for="Form.QuestionCount" class="form-control" min="1" max="10" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Lượt xoáy max</label>
                            <input type="number" asp-for="Form.MaxFollowUps" class="form-control" min="0" max="5" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Thời gian (giây)</label>
                            <input type="number" asp-for="Form.AnswerSeconds" class="form-control" min="15" max="300" step="5" />
                        </div>
                    </div>
                    <div class="form-text mt-2 text-secondary">
                        <i class="bi bi-info-circle me-1"></i> Câu hỏi sẽ được lấy ngẫu nhiên từ ngân hàng câu hỏi môn học đã được duyệt.
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-arrow-right-circle me-1"></i> Bắt đầu ngay
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Kiểm Tra Mic (Test Mic Visualizer) -->
<div class="modal fade" id="testMicModal" tabindex="-1" aria-labelledby="testMicModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="testMicModalLabel">
                    <i class="bi bi-mic-fill text-danger me-2"></i> Kiểm tra Microphone & Giọng nói
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <p class="text-secondary small mb-3">
                    Nói vài từ vào microphone (ví dụ: <em>"Một, hai, ba, bốn..."</em>) để kiểm tra độ nhạy và dạng sóng âm thanh.
                </p>

                <!-- Audio Wave Canvas -->
                <div class="visualizer-container rounded-3 p-2 bg-dark mb-3 position-relative overflow-hidden" style="height: 120px;">
                    <canvas id="micWaveCanvas" width="450" height="110" style="width:100%; height:100%;"></canvas>
                    <div id="micStatusOverlay" class="position-absolute top-50 start-50 translate-middle text-white small opacity-75">
                        <i class="bi bi-mic-mute fs-3 d-block mb-1"></i>
                        <span>Chưa bật kiểm tra mic</span>
                    </div>
                </div>

                <!-- Volume meter -->
                <div class="progress mb-3" style="height: 10px;">
                    <div id="micVolumeBar" class="progress-bar progress-bar-striped progress-bar-animated bg-success" role="progressbar" style="width: 0%"></div>
                </div>

                <div id="micLiveText" class="alert alert-light border small text-muted text-start" style="min-height: 48px;">
                    <i class="bi bi-chat-quote me-1"></i> <span id="micTranscriptPreview">Văn bản nhận diện giọng nói thử nghiệm sẽ xuất hiện ở đây...</span>
                </div>

                <div class="d-flex justify-content-center gap-2 mt-3">
                    <button id="btnStartMicTest" class="btn btn-outline-primary">
                        <i class="bi bi-play-fill me-1"></i> Bật thử Mic
                    </button>
                    <button id="btnStopMicTest" class="btn btn-outline-danger" disabled>
                        <i class="bi bi-stop-fill me-1"></i> Dừng thử
                    </button>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 justify-content-between">
                <div class="small text-muted" id="micDeviceLabel">
                    <i class="bi bi-headset me-1"></i> Thiết bị: Mặc định hệ thống
                </div>
                <button type="button" class="btn btn-primary btn-sm px-3" data-bs-dismiss="modal">Đã rõ, đóng lại</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/mic-test.js" asp-append-version="true"></script>
}
