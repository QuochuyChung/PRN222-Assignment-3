@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="error-box">
    <div class="eyebrow">Something went wrong</div>
    <h1 class="page-title mb-3">We couldn't process that request.</h1>

    @if (Model.ShowRequestId)
    {
        <p>Request ID: <code>@Model.RequestId</code></p>
    }

    <div class="notice notice-info mt-4">
        <i class="bi bi-info-circle" aria-hidden="true"></i>
        <div>
            For detailed errors while debugging locally, set <code>ASPNETCORE_ENVIRONMENT</code> to <code>Development</code>
            and restart the app. Do not enable Development mode on a deployed server.
        </div>
    </div>
</div>
