@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}
<div class="panel placeholder-panel">
    <i class="bi bi-exclamation-octagon" aria-hidden="true" style="color:var(--err)"></i>
    <h1 class="panel-title">Something went wrong</h1>
    <p>The request could not be completed. Please try again.</p>
    @if (!string.IsNullOrEmpty(Model.RequestId))
    {
        <p class="small-note">Request ID: <code>@Model.RequestId</code></p>
    }
</div>
