{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Infra": {
    "Mode": "Fake",
    "Role": "All"
  },

  "Database": {
    "AutoMigrate": false
  },

  "ConnectionStrings": {
    "SqlServer": ""
  },

  "Mongo": {
    "ConnectionString": "",
    "Database": "aiinterview"
  },
  "Redis": {
    "ConnectionString": ""
  },
  "Qdrant": {
    "Host": "localhost",
    "Port": 6334,
    "UseHttps": false,
    "ApiKey": "",
    "Collection": "chunks"
  },
  "Minio": {
    "Endpoint": "",
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "ai-interview-docs"
  },
  "Gemini": {
    "BaseUrl": "https://generativelanguage.googleapis.com/",
    "ApiKey": "",
    "Model": "",
    "EmbeddingModel": "",
    "EmbeddingDimensions": 768
  },
  "Embedding": {
    "Provider": "Ollama"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434/",
    "EmbeddingModel": "nomic-embed-text",
    "TimeoutSeconds": 120
  },
  "Ingestion": {
    "MaxFileSizeMb": 50,
    "ChunkSize": 1000,
    "ChunkOverlap": 150,
    "MaxAttempts": 3,
    "RetryBaseDelayMs": 1000,
    "PollIntervalMs": 1000
  },
  "Interview": {
    "QuestionCount": 3,
    "MaxFollowUps": 2,
    "AnswerSeconds": 60
  }
}
