{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AiInterview": {
    "InfraMode": "Fake",
    "Role": "all",
    "Minio": {
      "Endpoint": "localhost:9000",
      "AccessKey": "minioadmin",
      "SecretKey": "minioadmin",
      "BucketName": "ai-interview-docs",
      "ForcePathStyle": true,
      "UseSsl": false
    },
    "Mongo": {
      "ConnectionString": "mongodb://localhost:27017",
      "DatabaseName": "AiInterview",
      "CollectionName": "documents"
    },
    "Redis": {
      "ConnectionString": "localhost:6379",
      "DocsStreamKey": "docs-stream",
      "DocsConsumerGroup": "docs-workers"
    },
    "Qdrant": {
      "Endpoint": "http://localhost:6334",
      "ApiKey": "",
      "CollectionName": "chunks"
    },
    "Embedding": {
      "ModelName": "text-embedding-004",
      "Dimensions": 768,
      "ApiKey": "",
      "BatchSize": 16,
      "MaxRetries": 3,
      "InitialBackoffMs": 500
    },
    "Chunking": {
      "ChunkSize": 500,
      "ChunkOverlap": 100
    }
  }
}
