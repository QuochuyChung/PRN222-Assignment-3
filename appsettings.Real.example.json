{
  "Infra": {
    "Mode": "Real",
    "Role": "All"
  },

  "Database": {
    "AutoMigrate": false
  },

  "ConnectionStrings": {
    "SqlServer": "Server=<mssql-host>,1433;Database=AiInterview;User Id=<login-rieng>;Password=<tu-Vault>;TrustServerCertificate=True"
  },

  "Mongo": {
    "ConnectionString": "mongodb://<user>:<password-tu-Vault>@192.168.58.24:27017/?authSource=admin",
    "Database": "aiinterview"
  },

  "Redis": {
    "ConnectionString": "<redis-host>:6379,password=<tu-Vault>"
  },

  "Qdrant": {
    "Host": "192.168.58.24",
    "Port": 6334,
    "UseHttps": false,
    "ApiKey": "",
    "Collection": "chunks"
  },

  "Minio": {
    "Endpoint": "http://192.168.58.24:9002",
    "AccessKey": "ai-interview-app",
    "SecretKey": "<tu-Vault>",
    "Bucket": "ai-interview-docs"
  },

  "Gemini": {
    "BaseUrl": "https://generativelanguage.googleapis.com/",
    "ApiKey": "<tu-Vault>",
    "Model": "gemini-3.5-flash-lite",
    "EmbeddingModel": "",
    "EmbeddingDimensions": 768
  },

  "Embedding": {
    "Provider": "Ollama"
  },

  "Ollama": {
    "BaseUrl": "http://192.168.58.24:11434/",
    "EmbeddingModel": "nomic-embed-text",
    "TimeoutSeconds": 120
  },

  "Ingestion": {
    "MaxFileSizeMb": 50,
    "ChunkSize": 1000,
    "ChunkOverlap": 150,
    "MaxAttempts": 3,
    "RetryBaseDelayMs": 1000,
    "PollIntervalMs": 1000
  },

  "Interview": {
    "QuestionCount": 3,
    "MaxFollowUps": 2,
    "AnswerSeconds": 60
  }
}
